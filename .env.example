# ==============================================
# FlowCraft Frontend Configuration - EXAMPLE
# ==============================================
# Copy this file to .env or .env.local and fill in your actual values
# NEVER commit .env file with sensitive data to version control!

# API Configuration
# For development, use localhost. For production, use your actual backend URL
VITE_API_URL=http://localhost:8002/api

# API Timeout (milliseconds)
# VITE_API_TIMEOUT=30000

# N8N Configuration (Optional - defaults are set in code)
# Uncomment and customize if you need different default values
# VITE_N8N_BASE_URL=https://n8n.your-domain.com/api/v1
# VITE_N8N_WEBHOOK_BASE=https://n8n.your-domain.com

# Application Settings (Optional)
# VITE_DEFAULT_PAGE_SIZE=20
# VITE_MAX_PAGE_SIZE=100

# Feature Flags (Optional)
# VITE_ENABLE_DEBUG=false
# VITE_ENABLE_ANALYTICS=false

# Production Build Configuration
# For production builds, set these values:
# VITE_API_URL=https://api.your-domain.com/api
# NODE_ENV=production
